  "private": true,
  "dependencies": {
    "@minitui/renderer-core": "workspace:*",
    "@minitui/renderer-ink": "workspace:*",
    "@minitui/spec": "workspace:*",
    "@minitui/types": "workspace:*",
    "ink-testing-library": "catalog:"
  },
  "devDependencies": {
    "@minitui/catalog": "workspace:*",
    "@types/node": "catalog:",
