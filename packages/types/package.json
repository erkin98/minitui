{
  "name": "@minitui/types",
  "version": "0.0.0",
  "private": false,
  "dependencies": {
    "@types/node": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
