{"op":"add","path":"/root","value":"main"}
{"op":"add","path":"/elements/main","value":{"type":"Box","props":{"flexDirection":"column","gap":1},"children":["title","order","codec","output","merge","progress","status"]}}
{"op":"add","path":"/elements/title","value":{"type":"Text","props":{"text":"Merge videos","bold":true}}}
{"op":"add","path":"/elements/order","value":{"type":"OrderList","props":{"items":{"$bindState":"/inputs"}}}}
{"op":"add","path":"/elements/codec","value":{"type":"Text","props":{"text":{"$template":"Codec: ${/codec}"}}}}
{"op":"add","path":"/elements/output","value":{"type":"Text","props":{"text":{"$template":"Output: ${/output}"}}}}
{"op":"add","path":"/elements/merge","value":{"type":"Button","props":{"label":"Merge"},"on":{"press":{"action":"merge","params":{"inputs":{"$state":"/inputs"},"codec":{"$state":"/codec"},"output":{"$state":"/output"}}}}}}
{"op":"add","path":"/elements/progress","value":{"type":"ProgressBar","props":{"progress":{"$state":"/merge/progress"}}}}
{"op":"add","path":"/elements/status","value":{"type":"Text","props":{"text":{"$state":"/merge/status"}}}}
{"op":"add","path":"/state","value":{"inputs":["@@CASE_DIR@@/cam a.mp4","@@CASE_DIR@@/cam b.mp4"],"codec":"mpeg4","output":"@@CASE_DIR@@/cams.mp4","merge":{"progress":0,"status":""}}}
